<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Доступ в интернет: нужен для проверки IP и для VPN-подключения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Сервис, который работает в фоне и показывает постоянное уведомление -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Тип сервиса "особое назначение" требуется только на Android 14 и новее -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34" />
    <!-- Показ уведомлений на Android 13 и новее -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".FastikVpnApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="FastikVPN"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastikVPN">

        <!-- Единственная Activity; intent-filter делает её точкой входа (значок на рабочем столе) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FastikVPN.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Наш VPN-сервис. BIND_VPN_SERVICE: только система может к нему подключиться.
     exported=false: другие приложения не могут его запускать -->
        <service
            android:name=".vpn.FastikVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <!-- Пояснение для системы, зачем сервису тип specialUse -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>